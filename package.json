{
  "name": "rollup-plugin-output-size",
  "version": "2.0.0",
  "description": "A Rollup plugin that displays output bundle sizes.",
  "keywords": [
    "rollup-plugin",
    "output-size",
    "summary",
    "output",
    "size",
    "gzip"
  ],
  "homepage": "https://github.com/Arnesfield/rollup-plugin-output-size#readme",
  "bugs": {
    "url": "https://github.com/Arnesfield/rollup-plugin-output-size/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arnesfield/rollup-plugin-output-size.git"
  },
  "license": "MIT",
  "author": "Jefferson Rylee <rylee.jeff385@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "npm run check -- npm:bundle",
    "prebundle": "rimraf lib",
    "bundle": "rollup -c rollup.config.ts --configPlugin \"esbuild={target:'esnext'}\" --configImportAttributesKey with",
    "check": "concurrently -r --kill-others-on-fail tsc \"npm:lint -- --max-warnings 0\"",
    "format": "npm run lint -- --fix && prettier -cw .",
    "lint": "eslint .",
    "start": "npm run watch -- --environment NODE_ENV:development",
    "test": "npm run check -- mocha",
    "test:watch": "mocha -w",
    "watch": "npm run bundle -- -w --no-watch.clearScreen"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-eslint": "^9.2.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.2",
    "@types/sinon": "^21.0.0",
    "chai": "^6.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "pretty-bytes": "^7.1.0",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^8.1.2",
    "sinon": "^21.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "peerDependencies": {
    "rollup": "^2.0.0 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
